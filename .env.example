NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://wyrmora:wyrmora_dev_password@localhost:5432/wyrmora
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-at-least-32-random-characters
