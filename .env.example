NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://wyrmora:wyrmora_dev_password@localhost:5432/wyrmora
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-at-least-32-random-characters
COOKIE_NAME=wyrmora_session
COOKIE_SECURE=false
ENABLE_TEST_ORDER_WORKFLOW=false

# Needed only for one-time first Super Admin setup; remove after setup.
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-long-random-one-time-secret

# Enable only after legal, pharmacy and merchant-payment approvals are verified.
ENABLE_MARKETPLACE_ORDERS=false

# Account verification and password recovery (Resend)
PUBLIC_APP_URL=https://your-frontend-domain.example
RESEND_API_KEY=replace-with-resend-api-key
EMAIL_FROM=WYRMORA <no-reply@your-verified-domain.example>

# S3-compatible private object storage (optional until configured)
PRIVATE_ASSETS_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_SERVER_SIDE_ENCRYPTION=

# Khalti KPG-2 payment (keep marketplace orders disabled until approvals)
KHALTI_ENV=sandbox
KHALTI_SECRET_KEY=
KHALTI_RETURN_URL=https://your-frontend.example/payment-result
KHALTI_WEBSITE_URL=https://your-frontend.example
